# Copier en .env et renseigner localement. Ne jamais committer de valeur réelle.

# PostgreSQL — source transactionnelle unique (également utilisée par River)
DATABASE_URL=postgres://kofra:kofra@localhost:5432/kofra?sslmode=disable

# control-plane/cmd/kofra-api
KOFRA_API_PORT=8080
KOFRA_API_ENV=development

# Observabilité
SENTRY_DSN=

# web/
NEXT_PUBLIC_KOFRA_API_URL=http://localhost:8080
