# Copier en .env et renseigner localement. Ne jamais committer de valeur réelle.

# PostgreSQL 16.9 — source transactionnelle unique (également utilisée par River).
# Identifiants de développement local uniquement ; jamais réutilisés hors du poste.
# Rôles (ADR 0009) : kofra_owner (init infra), kofra_migrator (DDL), kofra_app (runtime).
# Le runtime se connecte avec kofra_app, qui n'est jamais superutilisateur.
DATABASE_URL=postgres://kofra_app:kofra@localhost:5432/kofra?sslmode=disable

# URL utilisée par le point d'entrée de migration (rôle kofra_migrator, ADR 0010)
MIGRATE_DATABASE_URL=postgres://kofra_migrator:kofra@localhost:5432/kofra?sslmode=disable

# control-plane/cmd/kofra-api
KOFRA_API_PORT=8080
KOFRA_API_ENV=development

# Observabilité — ADR 0012 : log/slog JSON + fondation OpenTelemetry, AUCUN
# exporteur SaaS distant en V1. Aucune donnée de télémétrie ne quitte
# l'infrastructure KOFRA. Ajouter un exporteur distant exige une nouvelle ADR
# et une revue au regard de docs/DATA_CLASSIFICATION.md — pas une variable ici.
KOFRA_LOG_LEVEL=info

# web/
NEXT_PUBLIC_KOFRA_API_URL=http://localhost:8080
